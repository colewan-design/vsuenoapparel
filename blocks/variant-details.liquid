{% doc %}
  Shows details for the currently selected variant, directly below the variant
  picker. Each child tier maps to one variant option value.
{% enddoc %}

<variant-details
  class="variant-details"
  data-product-id="{{ closest.product.id }}"
  {{ block.shopify_attributes }}
>
  {% if block.settings.heading != blank %}
    <div class="variant-details__header">
      <h3 class="variant-details__heading">{{ block.settings.heading | escape }}</h3>
    </div>
  {% endif %}

  <div class="variant-details__panels">
    {% content_for 'blocks' %}
  </div>
</variant-details>

{% stylesheet %}
  .variant-details {
    display: block;
    margin-block: 12px;
    border: 1px solid var(--color-border, rgb(0 0 0 / 12%));
    border-radius: var(--style-border-radius-inputs, 8px);
    background: var(--color-background, #fff);
  }

  .variant-details__header {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: 12px;
    padding: 14px 16px 0;
  }

  .variant-details__heading {
    margin: 0;
    font-size: 1.05rem;
    line-height: 1.2;
  }

  .variant-detail__label {
    margin: 0 0 10px;
    font-size: 0.7rem;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    opacity: 0.65;
  }

  .variant-detail {
    padding: 14px 16px 16px;
  }

  .variant-detail__rows {
    display: grid;
    gap: 10px;
    margin: 0;
  }

  .variant-detail__row {
    display: grid;
    grid-template-columns: minmax(7.5rem, 8.5rem) 1fr;
    gap: 10px;
    align-items: start;
    padding-block-start: 10px;
    border-block-start: 1px solid var(--color-border, rgb(0 0 0 / 8%));
  }

  .variant-detail__row:first-child {
    padding-block-start: 0;
    border-block-start: 0;
  }

  .variant-detail__row dt {
    display: flex;
    align-items: center;
    gap: 7px;
    margin: 0;
    font-size: 0.82rem;
    opacity: 0.7;
  }

  .variant-detail__row dt svg {
    width: 15px;
    height: 15px;
    flex: none;
  }

  .variant-detail__row dd {
    margin: 0;
    font-size: 0.88rem;
    line-height: 1.5;
  }

  .variant-detail__row dd ul {
    margin: 0;
    padding-inline-start: 1.1em;
  }

  .variant-detail__row dd p {
    margin: 0;
  }

  /**
   * The stock line is the one row whose value is live data rather than merchant
   * copy, so it carries the same status colours the product-inventory block uses.
   * Colour lands on the `dd` so it still applies once variant-details.js splits
   * the text into per-character spans for the reveal.
   */
  .variant-detail__row--stock dd {
    font-variant-numeric: tabular-nums;
  }

  .variant-detail__row--stock dd[data-stock-status='low'] {
    color: var(--color-lowstock);
  }

  .variant-detail__row--stock dd[data-stock-status='out_of_stock'] {
    color: var(--color-outofstock);
  }

  .variant-detail__row--stock dt svg {
    color: var(--color-instock);
  }

  .variant-detail__row--stock:has(dd[data-stock-status='low']) dt svg {
    color: var(--color-lowstock);
  }

  .variant-detail__row--stock:has(dd[data-stock-status='out_of_stock']) dt svg {
    color: var(--color-outofstock);
  }

  @media screen and (max-width: 749px) {
    .variant-detail__row {
      grid-template-columns: 1fr;
      gap: 4px;
    }
  }

  /**
   * Staggered reveal when switching variants. Shares the easing and feel of
   * smooth-text-animation.css, but works per letter: each character rises out
   * from behind its own mask, overshoots, and settles, one after the next, so a
   * label reads as a wave travelling along the word.
   *
   * Two layers of stagger compose into one animation-delay:
   *   row   -- `--vd-index` is set per row by variant-details.js and inherits
   *            down to the characters, so later rows start later.
   *   letter-- `--vd-char-index` is set per character when the text is split.
   *
   * Only short, plain-text elements are split (see variant-details.js). Rich
   * `dd` content -- the bullet lists -- would need hundreds of spans and a
   * multi-second tail, so it keeps the simpler whole-block rise and is selected
   * here by the absence of the `data-vd-split` marker the splitter leaves.
   *
   * Only applied by variant-details.js on an actual variant change, so the
   * first paint of the page stays still.
   */
  .variant-details {
    --vd-duration: 620ms;
    --vd-stagger: 55ms;
    --vd-char-duration: 560ms;
    --vd-char-stagger: 20ms;

    /* How far the rich-content rise trails its own row label. */
    --vd-rich-offset: 140ms;

    /* Headroom so the mask clips neither descenders nor the overshoot. */
    --vd-mask-space: 0.2em;
  }

  /* Keeps line breaks at spaces even though every character is inline-block. */
  .vd-word {
    display: inline-block;
    white-space: nowrap;
  }

  .vd-char {
    display: inline-block;
    overflow: hidden;
    vertical-align: top;

    /* Padding grows the clip box; the negative margin keeps the layout put. */
    padding-block: var(--vd-mask-space);
    margin-block: calc(var(--vd-mask-space) * -1);
  }

  .vd-char__inner {
    display: inline-block;
  }

  .variant-detail--animate .vd-char__inner {
    will-change: transform, opacity;
    animation: vd-char-rise var(--vd-char-duration) cubic-bezier(0.22, 1, 0.36, 1) both;
    animation-delay: calc(
      var(--vd-index, 0) * var(--vd-stagger) + var(--vd-char-index, 0) * var(--vd-char-stagger)
    );
  }

  /* Rise from behind the mask, overshoot, settle back — the caterpillar kick. */
  @keyframes vd-char-rise {
    0% {
      transform: translateY(110%);
      opacity: 0;
    }

    45% {
      opacity: 1;
    }

    62% {
      transform: translateY(-16%);
    }

    80% {
      transform: translateY(5%);
    }

    92% {
      transform: translateY(-2%);
    }

    100% {
      transform: translateY(0);
      opacity: 1;
    }
  }

  .variant-detail--animate .variant-detail__row dd:not([data-vd-split]) {
    will-change: transform, opacity;
    animation: vd-row-rise var(--vd-duration) cubic-bezier(0.22, 1, 0.36, 1) both;
    animation-delay: calc(var(--vd-index, 0) * var(--vd-stagger) + var(--vd-rich-offset));
  }

  @keyframes vd-row-rise {
    from {
      opacity: 0;
      transform: translateY(9px);
    }

    to {
      opacity: 1;
      transform: translateY(0);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .variant-detail--animate .vd-char__inner,
    .variant-detail--animate .variant-detail__row dd:not([data-vd-split]) {
      animation: none;
      opacity: 1;
      transform: none;
      will-change: auto;
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "Variant details",
  "tag": null,
  "blocks": [{ "type": "_variant-detail-tier" }],
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Variant details"
    }
  ],
  "presets": [{ "name": "Variant details" }]
}
{% endschema %}
