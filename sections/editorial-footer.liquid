<div class="editorial-footer">
  <div class="editorial-footer__inner">
    <div class="editorial-footer__brand">
      <a href="{{ routes.root_url }}" aria-label="{{ shop.name | escape }}">
        {% if settings.logo != blank %}
          {{ settings.logo | image_url: width: 520 | image_tag: widths: '220, 360, 520', loading: 'lazy', alt: shop.name }}
        {% else %}
          <span>{{ shop.name }}</span>
        {% endif %}
      </a>
      <p>{{ section.settings.tagline | escape }}</p>
    </div>

    <nav class="editorial-footer__nav" aria-label="Shop">
      <h2>{{ section.settings.shop_heading | escape }}</h2>
      {% for link in section.settings.shop_menu.links %}
        <a href="{{ link.url }}">{{ link.title | escape }}</a>
      {% endfor %}
    </nav>

    <nav class="editorial-footer__nav" aria-label="Help">
      <h2>{{ section.settings.help_heading | escape }}</h2>
      {% for link in section.settings.help_menu.links %}
        <a href="{{ link.url }}">{{ link.title | escape }}</a>
      {% endfor %}
    </nav>

    <div class="editorial-footer__social">
      <h2>{{ section.settings.social_heading | escape }}</h2>
      <div class="editorial-footer__social-links">
        {% if section.settings.instagram_url != blank %}
          <a href="{{ section.settings.instagram_url }}" aria-label="Instagram">
            <svg viewBox="0 0 24 24" aria-hidden="true"><rect x="3" y="3" width="18" height="18" rx="5"/><circle cx="12" cy="12" r="4"/><circle cx="17.5" cy="6.5" r="1" class="editorial-footer__icon-fill"/></svg>
          </a>
        {% endif %}
        {% if section.settings.tiktok_url != blank %}
          <a href="{{ section.settings.tiktok_url }}" aria-label="TikTok">
            <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M15 4v10.2a4.2 4.2 0 1 1-3.6-4.15V13a1.7 1.7 0 1 0 1.1 1.6V4h2.5Zm0 0c.35 2.35 1.7 3.8 4 4.2v2.7c-1.5-.15-2.85-.7-4-1.65"/></svg>
          </a>
        {% endif %}
        {% if section.settings.pinterest_url != blank %}
          <a href="{{ section.settings.pinterest_url }}" aria-label="Pinterest">
            <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M8.4 20.2c.7-2.1 1.2-3.2 1.7-5.5-.9-1.7.1-5.1 2.1-5.1 1.6 0 1.4 2.5 1.1 3.8-.3 1.6.8 2.8 2.4 2.8 2.9 0 4.1-3.7 4.1-6.3 0-3.6-2.9-6.3-7.1-6.3-5.2 0-8.2 3.8-8.2 7.9 0 2.3.9 4.1 2.5 4.8.3.1.5 0 .6-.3l.3-1.2c.1-.4.1-.5-.2-.8-.5-.6-.9-1.5-.9-2.8 0-2.9 2.2-5.7 6.2-5.7 3.4 0 5.7 2.3 5.7 5.2 0 3.5-2 6.1-4.7 6.1-1.5 0-2.5-1.2-2.2-2.7l.8-3.1c.2-1-.2-1.8-1.1-1.8-1.1 0-2 1.2-2 2.8 0 1 .3 1.7.3 1.7s-1.1 4.7-1.3 5.5c-.2.7-.2 1.4-.1 2.1"/></svg>
          </a>
        {% endif %}
      </div>
      <p>{{ section.settings.social_text | escape }}</p>
    </div>
  </div>

  <div class="editorial-footer__bottom">
    <span>© {{ 'now' | date: '%Y' }} {{ shop.name }}</span>
    <div>
      {% for policy in shop.policies %}
        {% if policy != blank %}<a href="{{ policy.url }}">{{ policy.title | escape }}</a>{% endif %}
      {% endfor %}
    </div>
  </div>
</div>

{% stylesheet %}
  .editorial-footer {
    --footer-ink: #3d2b27;
    color: var(--footer-ink);
    background: #f8f5f1;
    border-top: 1px solid rgba(61, 43, 39, 0.16);
  }

  .editorial-footer__inner,
  .editorial-footer__bottom {
    width: min(100% - clamp(2rem, 8vw, 8rem), 77rem);
    margin-inline: auto;
  }

  .editorial-footer__inner {
    display: grid;
    grid-template-columns: minmax(15rem, 1.5fr) repeat(3, minmax(8rem, 0.65fr));
    gap: clamp(2rem, 5vw, 5rem);
    padding-block: clamp(3rem, 6vw, 5rem);
  }

  .editorial-footer__brand img {
    width: min(100%, 17rem);
    height: auto;
    display: block;
  }

  .editorial-footer__brand > a > span {
    font-family: var(--font-heading--family);
    font-size: 2rem;
  }

  .editorial-footer__brand p,
  .editorial-footer__social p {
    max-width: 19rem;
    margin: 1rem 0 0;
    font-family: var(--font-accent--family);
    font-size: 0.68rem;
    letter-spacing: 0.09em;
    line-height: 1.4;
    text-transform: uppercase;
  }

  .editorial-footer h2 {
    margin: 0 0 1rem;
    font-family: var(--font-accent--family);
    font-size: 0.72rem;
    font-weight: 600;
    letter-spacing: 0.1em;
    text-transform: uppercase;
  }

  .editorial-footer__nav a {
    width: fit-content;
    display: block;
    margin-block: 0.55rem;
    color: inherit;
    font-family: var(--font-body--family);
    font-size: 0.84rem;
    text-decoration: none;
  }

  .editorial-footer__nav a:hover {
    text-decoration: underline;
    text-underline-offset: 0.25rem;
  }

  .editorial-footer__social-links {
    display: flex;
    gap: 0.65rem;
  }

  .editorial-footer__social-links a {
    width: 2.2rem;
    aspect-ratio: 1;
    display: grid;
    place-items: center;
    color: inherit;
    border: 1px solid currentColor;
    border-radius: 50%;
    font-family: var(--font-accent--family);
    font-size: 0.62rem;
    font-weight: 600;
    text-decoration: none;
  }

  .editorial-footer__social-links svg {
    width: 1rem;
    height: 1rem;
    fill: none;
    stroke: currentColor;
    stroke-linecap: round;
    stroke-linejoin: round;
    stroke-width: 1.6;
  }

  .editorial-footer__social-links .editorial-footer__icon-fill {
    fill: currentColor;
    stroke: none;
  }

  .editorial-footer__bottom {
    display: flex;
    justify-content: space-between;
    gap: 1rem;
    padding-block: 1.25rem;
    border-top: 1px solid rgba(61, 43, 39, 0.16);
    font-family: var(--font-body--family);
    font-size: 0.68rem;
  }

  .editorial-footer__bottom div {
    display: flex;
    flex-wrap: wrap;
    gap: 1rem;
  }

  .editorial-footer__bottom a {
    color: inherit;
  }

  /* Between the phone and desktop breakpoints the rigid column minimums
     (15rem + 3 x 8rem + three 5vw gaps) add up to more than the container, so
     the social column pushed ~2px past the viewport and put a horizontal
     scrollbar on every page. Let the columns shrink instead. */
  @media screen and (min-width: 750px) and (max-width: 989px) {
    .editorial-footer__inner {
      grid-template-columns: minmax(0, 1.5fr) repeat(3, minmax(0, 0.65fr));
      gap: clamp(1.5rem, 3.5vw, 3rem);
    }
  }

  @media screen and (max-width: 749px) {
    .editorial-footer__inner,
    .editorial-footer__bottom {
      width: calc(100% - 2rem);
    }

    .editorial-footer__inner {
      grid-template-columns: repeat(2, minmax(0, 1fr));
      gap: 2.5rem 1.5rem;
    }

    .editorial-footer__brand {
      grid-column: 1 / -1;
    }

    .editorial-footer__social {
      grid-column: 1 / -1;
    }

    .editorial-footer__bottom {
      flex-direction: column;
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "Editorial footer",
  "tag": "section",
  "class": "editorial-footer-section",
  "enabled_on": { "groups": ["footer"] },
  "settings": [
    { "type": "text", "id": "tagline", "label": "Tagline", "default": "Vintage today. Brighter tomorrow." },
    { "type": "text", "id": "shop_heading", "label": "Shop heading", "default": "Shop" },
    { "type": "link_list", "id": "shop_menu", "label": "Shop menu", "default": "main-menu" },
    { "type": "text", "id": "help_heading", "label": "Help heading", "default": "Help" },
    { "type": "link_list", "id": "help_menu", "label": "Help menu", "default": "footer" },
    { "type": "text", "id": "social_heading", "label": "Social heading", "default": "Let's connect" },
    { "type": "text", "id": "social_text", "label": "Social text", "default": "Good clothes. Brighter days. ♡" },
    { "type": "url", "id": "instagram_url", "label": "Instagram URL" },
    { "type": "url", "id": "tiktok_url", "label": "TikTok URL" },
    { "type": "url", "id": "pinterest_url", "label": "Pinterest URL" }
  ],
  "presets": [{ "name": "Editorial footer", "category": "Footer" }]
}
{% endschema %}
