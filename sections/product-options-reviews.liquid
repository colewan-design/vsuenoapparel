{% liquid
  assign option_blocks = section.blocks | where: 'type', 'option'
  assign review_blocks = section.blocks | where: 'type', 'review'
  assign show_reviews = request.design_mode

  for review_block in review_blocks
    if review_block.settings.video != blank or review_block.settings.external_video != blank or review_block.settings.cover_image != blank or review_block.settings.quote != blank or review_block.settings.customer_name != blank
      assign show_reviews = true
      break
    endif
  endfor
%}

<div
  class="section-background product-options-reviews__background"
  style="--por-background: {{ section.settings.background_color }}; background: {{ section.settings.background_color }};"
></div>

<section
  class="section section--page-width product-options-reviews"
  style="
    --por-background: {{ section.settings.background_color }};
    --por-foreground: {{ section.settings.text_color }};
    --por-accent: {{ section.settings.accent_color }};
    --por-padding-top: {{ section.settings.padding_top }}px;
    --por-padding-bottom: {{ section.settings.padding_bottom }}px;
  "
  aria-labelledby="ProductOptionsHeading-{{ section.id }}"
>
  <product-options-reviews class="product-options-reviews__inner">
    {% if option_blocks.size > 0 %}
      <div class="product-options-reviews__header">
        <div>
          {% if section.settings.eyebrow != blank %}
            <p class="product-options-reviews__eyebrow">{{ section.settings.eyebrow | escape }}</p>
          {% endif %}
          <h2 id="ProductOptionsHeading-{{ section.id }}" class="product-options-reviews__heading">
            {{ section.settings.heading | escape }}
          </h2>
        </div>

        {% if section.settings.intro != blank %}
          <div class="product-options-reviews__intro rte">{{ section.settings.intro }}</div>
        {% endif %}
      </div>

      <div
        class="product-options-reviews__options"
        role="tablist"
        aria-label="{{ section.settings.heading | escape }}"
      >
        {% for block in option_blocks %}
          <button
            class="product-option{% if forloop.first %} is-selected{% endif %}"
            type="button"
            role="tab"
            id="ProductOptionTab-{{ block.id }}"
            aria-controls="ProductOptionPanel-{{ block.id }}"
            aria-selected="{% if forloop.first %}true{% else %}false{% endif %}"
            tabindex="{% if forloop.first %}0{% else %}-1{% endif %}"
            data-variant-trigger="{{ block.id }}"
            data-block-id="{{ block.id }}"
            {{ block.shopify_attributes }}
          >
            <span class="product-option__identity">
              {% if block.settings.badge != blank %}
                <span class="product-option__badge">{{ block.settings.badge | escape }}</span>
              {% endif %}
              <span class="product-option__name">{{ block.settings.title | escape }}</span>
            </span>
            <span class="product-option__price">{{ block.settings.price | escape }}</span>
            <span class="product-option__measure">
              <span class="product-option__measure-label">Pieces</span>
              {{ block.settings.pieces | escape }}
            </span>
            <span class="product-option__measure">
              <span class="product-option__measure-label">Weight</span>
              {{ block.settings.weight | escape }}
            </span>
            <span class="product-option__indicator" aria-hidden="true">
              {{- 'icon-caret.svg' | inline_asset_content -}}
            </span>
          </button>
        {% endfor %}
      </div>

      <div class="product-options-reviews__details" aria-live="polite">
        {% for block in option_blocks %}
          <div
            class="product-option-detail{% if forloop.first %} is-selected{% endif %}"
            id="ProductOptionPanel-{{ block.id }}"
            role="tabpanel"
            aria-labelledby="ProductOptionTab-{{ block.id }}"
            data-variant-panel="{{ block.id }}"
            {% unless forloop.first %}hidden{% endunless %}
          >
            <div class="product-option-detail__copy">
              {% if block.settings.detail_heading != blank %}
                <p class="product-option-detail__eyebrow">{{ block.settings.detail_heading | escape }}</p>
              {% endif %}
              {% if block.settings.detail != blank %}
                <p class="product-option-detail__text" data-variant-detail-text>{{ block.settings.detail | escape }}</p>
              {% endif %}
            </div>

            {% if block.settings.link != blank and block.settings.link_label != blank %}
              <a class="product-option-detail__link button" href="{{ block.settings.link }}">
                {{ block.settings.link_label | escape }}
              </a>
            {% endif %}
          </div>
        {% endfor %}
      </div>
    {% endif %}

    {% if show_reviews and review_blocks.size > 0 %}
      <div class="product-reviews" aria-labelledby="ProductReviewsHeading-{{ section.id }}">
        <div class="product-reviews__header">
          <p class="product-options-reviews__eyebrow">{{ section.settings.reviews_eyebrow | escape }}</p>
          <h2 id="ProductReviewsHeading-{{ section.id }}" class="product-options-reviews__heading">
            {{ section.settings.reviews_heading | escape }}
          </h2>
        </div>

        <div class="product-reviews__grid">
          {% for block in review_blocks %}
            {% liquid
              assign has_review_content = false
              if block.settings.video != blank or block.settings.external_video != blank or block.settings.cover_image != blank or block.settings.quote != blank or block.settings.customer_name != blank
                assign has_review_content = true
              endif
            %}

            {% if has_review_content or request.design_mode %}
              <article class="product-review-card" {{ block.shopify_attributes }}>
                <div class="product-review-card__media">
                  {% if block.settings.video != blank %}
                    {{
                      block.settings.video
                      | video_tag:
                        image_size: '900x',
                        controls: true,
                        autoplay: false,
                        loop: false,
                        muted: false,
                        preload: 'metadata'
                    }}
                  {% elsif block.settings.external_video != blank %}
                    {{
                      block.settings.external_video
                      | external_video_url: autoplay: false, controls: true
                      | external_video_tag: loading: 'lazy', title: block.settings.video_alt
                    }}
                  {% elsif block.settings.cover_image != blank %}
                    {{
                      block.settings.cover_image
                      | image_url: width: 900
                      | image_tag:
                        widths: '360, 540, 720, 900',
                        sizes: '(min-width: 990px) 30vw, (min-width: 750px) 45vw, 100vw',
                        loading: 'lazy',
                        alt: block.settings.video_alt
                    }}
                  {% else %}
                    {{ 'product-apparel-1' | placeholder_svg_tag: 'product-review-card__placeholder' }}
                    <span class="product-review-card__play" aria-hidden="true">
                      {{- 'icon-play.svg' | inline_asset_content -}}
                    </span>
                  {% endif %}
                </div>

                {% if block.settings.quote != blank or block.settings.customer_name != blank %}
                  <div class="product-review-card__content">
                    {% if block.settings.rating > 0 %}
                      <div class="product-review-card__stars" aria-label="{{ block.settings.rating }} out of 5 stars">
                        {% for star in (1..5) %}
                          <span aria-hidden="true">{% if star <= block.settings.rating %}★{% else %}☆{% endif %}</span>
                        {% endfor %}
                      </div>
                    {% endif %}
                    {% if block.settings.quote != blank %}
                      <blockquote>{{ block.settings.quote | escape }}</blockquote>
                    {% endif %}
                    {% if block.settings.customer_name != blank %}
                      <p class="product-review-card__customer">{{ block.settings.customer_name | escape }}</p>
                    {% endif %}
                  </div>
                {% endif %}
              </article>
            {% endif %}
          {% endfor %}
        </div>
      </div>
    {% endif %}
  </product-options-reviews>
</section>

<script src="{{ 'product-options-reviews.js' | asset_url }}" type="module"></script>

{% stylesheet %}
  .product-options-reviews__background {
    background: var(--por-background);
  }

  .product-options-reviews {
    color: var(--por-foreground);
  }

  .product-options-reviews__inner {
    display: block;
    padding-block: var(--por-padding-top) var(--por-padding-bottom);
  }

  .product-options-reviews__header,
  .product-reviews__header {
    display: grid;
    gap: var(--gap-lg);
    margin-block-end: clamp(2rem, 5vw, 4.5rem);
  }

  .product-options-reviews__header {
    grid-template-columns: minmax(0, 1fr);
  }

  .product-options-reviews__eyebrow,
  .product-option-detail__eyebrow {
    margin: 0 0 var(--gap-sm);
    color: var(--por-accent);
    font-family: var(--font-accent--family);
    font-size: var(--font-size--xs);
    font-weight: 600;
    letter-spacing: 0.14em;
    text-transform: uppercase;
  }

  .product-options-reviews__heading {
    max-width: 14ch;
    margin: 0;
    font-family: var(--font-heading--family);
    font-size: clamp(2.25rem, 5vw, 5rem);
    font-weight: var(--font-heading--weight);
    letter-spacing: -0.035em;
    line-height: 0.95;
    text-wrap: balance;
  }

  .product-options-reviews__intro {
    max-width: 36rem;
    font-size: var(--font-size--lg);
    line-height: 1.55;
  }

  .product-options-reviews__options {
    border-block-start: 1px solid color-mix(in srgb, var(--por-foreground) 24%, transparent);
  }

  .product-option {
    width: 100%;
    display: grid;
    grid-template-columns: minmax(0, 1fr) auto;
    align-items: center;
    gap: var(--gap-md);
    padding: clamp(1rem, 2.5vw, 1.75rem) 0;
    color: inherit;
    background: transparent;
    border: 0;
    border-block-end: 1px solid color-mix(in srgb, var(--por-foreground) 24%, transparent);
    text-align: left;
    cursor: pointer;
    transition: color var(--animation-speed) var(--animation-easing),
      padding-inline var(--animation-speed) var(--animation-easing),
      background-color var(--animation-speed) var(--animation-easing);
  }

  .product-option:is(:hover, :focus-visible),
  .product-option.is-selected {
    color: var(--por-accent);
    padding-inline: clamp(0.75rem, 2vw, 1.5rem);
    background: color-mix(in srgb, var(--por-accent) 7%, transparent);
  }

  .product-option:focus-visible {
    outline: 2px solid var(--por-accent);
    outline-offset: 3px;
  }

  .product-option__identity {
    display: flex;
    min-width: 0;
    flex-direction: column;
    gap: 0.2rem;
  }

  .product-option__badge,
  .product-option__measure-label {
    color: var(--por-accent);
    font-family: var(--font-accent--family);
    font-size: 0.65rem;
    font-weight: 600;
    letter-spacing: 0.12em;
    text-transform: uppercase;
  }

  .product-option__name {
    overflow: hidden;
    font-family: var(--font-subheading--family);
    font-size: clamp(1.05rem, 2vw, 1.35rem);
    text-overflow: ellipsis;
    white-space: nowrap;
  }

  .product-option__price {
    font-family: var(--font-heading--family);
    font-size: clamp(1.5rem, 4vw, 2.4rem);
    line-height: 1;
  }

  .product-option__measure {
    display: none;
    flex-direction: column;
    gap: 0.25rem;
    font-variant-numeric: tabular-nums;
  }

  .product-option__indicator {
    width: 1rem;
    display: grid;
    place-items: center;
    rotate: -90deg;
    transition: rotate var(--animation-speed) var(--animation-easing);
  }

  .product-option.is-selected .product-option__indicator {
    rotate: 0deg;
  }

  .product-option-detail {
    display: grid;
    gap: var(--gap-xl);
    align-items: end;
    min-height: clamp(12rem, 26vw, 22rem);
    padding: clamp(1.5rem, 5vw, 4.5rem);
    color: var(--por-background);
    background: var(--por-accent);
  }

  .product-option-detail[hidden] {
    display: none;
  }

  .product-option-detail__copy {
    max-width: 60rem;
  }

  .product-option-detail__eyebrow {
    color: currentColor;
    opacity: 0.72;
  }

  .product-option-detail__text {
    margin: 0;
    font-family: var(--font-heading--family);
    font-size: clamp(1.8rem, 4.5vw, 4.5rem);
    line-height: 1.02;
    letter-spacing: -0.03em;
    text-wrap: balance;
  }

  .product-option-detail__link {
    width: fit-content;
    color: var(--por-accent);
    background: var(--por-background);
    border-color: var(--por-background);
  }

  .product-reviews {
    margin-block-start: clamp(5rem, 10vw, 10rem);
  }

  .product-reviews__grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 17rem), 1fr));
    gap: clamp(1rem, 2vw, 2rem);
  }

  .product-review-card {
    min-width: 0;
  }

  .product-review-card__media {
    position: relative;
    overflow: hidden;
    aspect-ratio: 9 / 16;
    background: color-mix(in srgb, var(--por-foreground) 8%, var(--por-background));
  }

  .product-review-card__media :is(video, iframe, img, svg) {
    width: 100%;
    height: 100%;
    display: block;
    object-fit: cover;
    border: 0;
  }

  .product-review-card__play {
    position: absolute;
    inset: 50% auto auto 50%;
    width: 3.5rem;
    aspect-ratio: 1;
    display: grid;
    place-items: center;
    translate: -50% -50%;
    color: var(--por-background);
    background: var(--por-accent);
    border-radius: 50%;
  }

  .product-review-card__play svg {
    width: 1rem;
    height: 1rem;
  }

  .product-review-card__content {
    padding-block-start: var(--gap-lg);
  }

  .product-review-card__stars {
    color: var(--por-accent);
    letter-spacing: 0.08em;
  }

  .product-review-card blockquote {
    margin: var(--gap-sm) 0;
    font-family: var(--font-subheading--family);
    font-size: clamp(1.1rem, 2vw, 1.4rem);
    line-height: 1.35;
  }

  .product-review-card__customer {
    margin: 0;
    color: color-mix(in srgb, var(--por-foreground) 68%, transparent);
    font-family: var(--font-accent--family);
    font-size: var(--font-size--sm);
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }

  @media screen and (min-width: 750px) {
    .product-options-reviews__header {
      grid-template-columns: minmax(0, 1.35fr) minmax(18rem, 0.65fr);
      align-items: end;
    }

    .product-option {
      grid-template-columns: minmax(10rem, 1.4fr) minmax(7rem, 0.45fr) minmax(8rem, 0.65fr) minmax(8rem, 0.65fr) auto;
    }

    .product-option__measure {
      display: flex;
    }

    .product-option-detail {
      grid-template-columns: minmax(0, 1fr) auto;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .product-option,
    .product-option__indicator {
      transition: none;
    }
  }
{% endstylesheet %}

